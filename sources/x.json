{
  "schema": 1,
  "id": "xvideo",
  "name": "X (Twitter)",
  "version": "1.0.0",
  "description": "把 X/Twitter 视频链接交给 pektino 解析，取回可直接下载的 mp4/HLS 地址",
  "baseUrl": "https://x.com",
  "hosts": [
    "x.com",
    "twitter.com",
    "video.twimg.com",
    "pbs.twimg.com",
    "pektino.com"
  ],
  "capabilities": [
    "scrape",
    "download"
  ],
  "defaults": {
    "timeoutSec": 60,
    "maxBytes": 8388608
  },
  "list": {
    "url": "/",
    "item": "article",
    "fields": {
      "id": {
        "selector": "a[href*='/status/']",
        "attr": "href",
        "regex": "status/(\\d+)"
      }
    }
  },
  "resolve": {
    "url": "https://pektino.com/api/media",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json",
      "Referer": "https://pektino.com/zh-CN"
    },
    "body": "{\"url\":\"{pageUrl}\",\"status\":\"draft\",\"saved_from_lang\":\"zh-CN\"}",
    "fields": {
      "title": {
        "jsonPath": "$.data.url_cd"
      },
      "cover": {
        "jsonPath": "$.data.thumbnail"
      },
      "playable": {
        "jsonPath": "$.data.url"
      }
    }
  },
  "download": {
    "kind": "http",
    "url": "{playable}",
    "headers": {
      "Referer": "https://x.com/"
    }
  }
}
