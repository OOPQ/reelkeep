{
  "schema": 1,
  "id": "demo-auth",
  "name": "Demo Auth Source",
  "version": "1.0.0",
  "author": "reelkeep",
  "description": "Synthetic fixture source with cookie auth, used by manager tests.",
  "baseUrl": "https://auth.example.com",
  "capabilities": ["scrape"],
  "list": {
    "url": "/list/{rank}?page={page}",
    "ranks": [{ "key": "latest", "label": "最新" }],
    "item": "a.card",
    "fields": {
      "id": { "selector": "a.card", "attr": "href", "regex": "/video/(\\d+)" },
      "title": { "selector": ".t" }
    }
  },
  "auth": { "type": "cookie", "loginUrl": "/login", "domains": ["auth.example.com"] }
}
