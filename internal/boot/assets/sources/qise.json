      },
      {
        "key": "jingdong",
        "label": "精东影业",
        "group": "分类",
        "path": "/videos/categories/jingdong/{page}"
      },
      {
        "key": "swag",
        "label": "台湾SWAG",
        "group": "分类",
        "path": "/videos/categories/swag/{page}"
      },
      {
        "key": "tuzi",
        "label": "兔子先生",
        "group": "分类",
        "path": "/videos/categories/tuzi/{page}"
      },
      {
        "key": "mitao",
        "label": "蜜桃传媒",
        "group": "分类",
        "path": "/videos/categories/mitao/{page}"
      },
      {
        "key": "huangjia",
        "label": "皇家华人",
        "group": "分类",
        "path": "/videos/categories/huangjia/{page}"
      }
    ],
    "item": "div.video-elem",
    "fields": {
      "id": {
        "selector": "a[href^='/videos/view/']",
        "attr": "href",
        "regex": "/videos/view/(\\d+)/"
      },
      "title": {
        "selector": "a.title"
      },
      "cover": {
        "selector": "div.img",
        "attr": "style",
        "regex": "url\\('([^']+)'\\)"
      },
      "duration": {
        "selector": "small.layer"
      },
      "pageUrl": {
        "selector": "a[href^='/videos/view/']",
        "attr": "href",
        "absolute": true
      }
    }
  },
  "detail": {
    "url": "{pageUrl}",
    "fields": {
      "title": {
        "selector": "meta[property='og:title']",
        "attr": "content"
      },
      "cover": {
        "selector": "meta[property='og:image']",
        "attr": "content"
      },
      "playable": {
        "raw": true,
        "regex": "data-src=\"(https?://[^\"]+\\.mp4[^\"]*)\""
      }
    }
  },
  "download": {
    "kind": "http",
    "url": "{playable}",
    "headers": {
      "Referer": "{baseUrl}/"
    },
    "onStatus": {
      "410": {
        "action": "refreshDetail",
        "retryOnce": true
      }
    }
  }
}
